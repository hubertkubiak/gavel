{
  "name": "@gavel/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "dev:fast": "cross-env SEED_FAST=1 tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.16.0",
    "@connectrpc/connect": "^2.3.0",
    "@connectrpc/connect-fastify": "^2.3.0",
    "@connectrpc/connect-node": "^2.3.0",
    "@fastify/cors": "^11.3.1",
    "@gavel/proto": "workspace:*",
    "fastify": "^5.12.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "cross-env": "^10.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.0",
    "vitest": "^5.0.5"
  }
}
